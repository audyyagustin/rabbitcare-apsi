@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #48664C
skinparam BorderColor #48664C
skinparam BackgroundColor #FAFCFA
skinparam NoteBackgroundColor #FFF7E8
skinparam NoteBorderColor #D99A43
title Activity - Pembayaran dan Validasi Admin
start
:Customer membuka invoice;
if (Payment status?) then (UNPAID / REJECTED)
  :Pilih metode pembayaran;
  :Lihat tujuan pembayaran;
  :Isi nama pengirim saja;
  :Kirim pengajuan;
  :Payment = SUBMITTED;
  :Booking = MENUNGGU_VALIDASI;
elseif (SUBMITTED)
  :Customer melihat Menunggu Validasi;
elseif (PAID)
  :Customer melihat pembayaran tervalidasi;
endif
:Admin membuka Validasi Pembayaran;
if (Payment = SUBMITTED?) then (Ya)
  if (Admin menerima?) then (Valid)
    :Payment = PAID;
    :Simpan validatedAt dan validatedBy;
    :Booking = TERKONFIRMASI;
    :Booking dapat di-check-in;
  else (Tolak)
    :Payment = REJECTED;
    :Booking = MENUNGGU_PEMBAYARAN;
  endif
else (Tidak)
  :Tidak ada tindakan validasi;
endif
stop
@enduml
