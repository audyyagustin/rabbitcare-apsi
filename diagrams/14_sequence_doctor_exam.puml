@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #48664C
skinparam BorderColor #48664C
skinparam BackgroundColor #FAFCFA
skinparam NoteBackgroundColor #FFF7E8
skinparam NoteBorderColor #D99A43
title Sequence - Pemeriksaan Dokter, Riwayat, dan Reminder
actor Doctor as "Dokter"
participant DoctorUI as "Dashboard/Form Dokter"
participant MedicalJS as "Medical Record JS"
database Store as "localStorage App Data"
participant History as "Riwayat Pemilik"
participant Calendar as "Kalender dan Reminder"
participant Manager as "Dashboard Manajer"

Doctor -> DoctorUI : buka pasien assigned doctor
DoctorUI -> MedicalJS : openDoctorExam(id)
MedicalJS -> Store : status = SEDANG_DILAYANI
Store --> DoctorUI : data booking dan pet
Doctor -> DoctorUI : isi anamnesis, fisik, diagnosis, tindakan
opt Simpan draft
  DoctorUI -> MedicalJS : saveDoctorDraft()
  MedicalJS -> Store : simpan medicalRecord sementara
end
Doctor -> DoctorUI : selesai pemeriksaan
DoctorUI -> MedicalJS : saveDoctorExam()
MedicalJS -> MedicalJS : validasi diagnosis dan tindakan
MedicalJS -> Store : medicalRecord + SELESAI
completedRole = doctor
opt tanggal kontrol diisi
  MedicalJS -> Store : reminder Kontrol Dokter
end
Store --> History : medicalRecord tampil kronologis
Store --> Calendar : booking dan dueDate tampil
Store --> Manager : statistik selesai dan pendapatan diperbarui
@enduml
