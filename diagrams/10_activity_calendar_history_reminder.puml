@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #48664C
skinparam BorderColor #48664C
skinparam BackgroundColor #FAFCFA
skinparam NoteBackgroundColor #FFF7E8
skinparam NoteBorderColor #D99A43
title Activity - Integrasi Kalender, Riwayat, dan Reminder
start
:Pengguna login sesuai peran;
:Sistem membaca pets dan bookings dari localStorage;
if (Peran = owner?) then (Ya)
  :Filter data berdasarkan ownerEmail;
elseif (Peran = doctor?) then (Ya)
  :Filter booking assigned/completed doctor;
elseif (Peran = groomer?) then (Ya)
  :Filter booking assigned/completed groomer;
else (Admin / Manager)
  :Gunakan seluruh data klinik;
endif
fork
  :Kalender membentuk agenda dari tanggal booking;
  :Tambahkan reminder dueDate sebagai agenda;
fork again
  :Riwayat memilih pet yang benar dari scopedPets;
  :Bangun entri dari medicalRecord dan groomingRecord;
  :Klasifikasikan vaksinasi dari jenis layanan;
fork again
  :Reminder dibentuk dari followUpDate atau nextDate;
  :Tampilkan jumlah dan status reminder;
end fork
if (Data tersedia?) then (Ya)
  :Tampilkan data sesuai kelinci dan peran;
else (Tidak)
  :Tampilkan empty state tanpa data contoh;
endif
stop
@enduml
