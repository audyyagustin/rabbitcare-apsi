@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #48664C
skinparam BorderColor #48664C
skinparam BackgroundColor #FAFCFA
skinparam NoteBackgroundColor #FFF7E8
skinparam NoteBorderColor #D99A43
title Activity - Pemeriksaan Dokter dan Integrasi Riwayat
start
:Dokter login Portal Klinik;
:Dokter melihat pasien yang assignedRole = doctor;
:Dokter membuka pasien;
:Status = SEDANG_DILAYANI;
:Dokter melihat identitas, keluhan, jadwal, dan riwayat pasien;
:Dokter mengisi anamnesis;
:Dokter mengisi pemeriksaan fisik;
if (Simpan sebagai draft?) then (Ya)
  :Simpan medicalRecord sementara;
  :Status tetap SEDANG_DILAYANI;
else (Tidak)
endif
:Dokter mengisi diagnosis dan tindakan;
:Dokter dapat mengisi resep;
:Dokter dapat menentukan tanggal kontrol;
if (Diagnosis dan tindakan lengkap?) then (Ya)
  :Simpan medicalRecord;
  :Status booking = SELESAI;
  :completedRole = doctor;
  if (Ada tanggal kontrol?) then (Ya)
    :Buat reminder Kontrol Dokter;
  endif
  :Riwayat pemilik dan kalender diperbarui;
  :Dashboard admin dan manajer diperbarui;
else (Tidak)
  :Tampilkan data belum lengkap;
endif
stop
@enduml
