@startuml
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #48664C
skinparam BorderColor #48664C
skinparam BackgroundColor #FAFCFA
skinparam NoteBackgroundColor #FFF7E8
skinparam NoteBorderColor #D99A43
title Sequence - Grooming, Penyelesaian, atau Rujukan
actor Groomer
participant GroomerUI as "Dashboard/Form Groomer"
participant GroomingJS as "Grooming JS"
database Store as "localStorage App Data"
participant AdminUI as "Portal Admin"
participant History as "Riwayat Pemilik"
participant Calendar as "Kalender dan Reminder"

Groomer -> GroomerUI : buka pasien assigned groomer
GroomerUI -> GroomingJS : openGroomingForm(id)
GroomingJS -> Store : status = SEDANG_DILAYANI
Groomer -> GroomerUI : isi kondisi awal dan keamanan
alt aman dan tidak perlu rujukan
  Groomer -> GroomerUI : isi hasil, temuan, nextDate
  GroomerUI -> GroomingJS : saveGroomingResult()
  GroomingJS -> Store : groomingRecord + SELESAI
completedRole = groomer
  opt nextDate tersedia
    GroomingJS -> Store : reminder Grooming Berikutnya
  end
  Store --> History : hasil grooming tampil
  Store --> Calendar : booking/reminder tampil
else tidak aman atau perlu dokter
  GroomerUI -> GroomingJS : stopGroomingIntegrated()
  GroomingJS -> Store : groomingRecord + referral
status = PERLU_RUJUKAN
assignedRole dikosongkan
  Store --> AdminUI : tombol Arahkan ke Dokter
end
@enduml
